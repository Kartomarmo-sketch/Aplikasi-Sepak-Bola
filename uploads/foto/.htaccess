# Folder foto profil: hanya berkas gambar yang boleh dilayani; skrip tidak pernah dijalankan.
Options -Indexes -ExecCGI
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar
<FilesMatch "\.(php|phtml|phar|php[0-9]?|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>